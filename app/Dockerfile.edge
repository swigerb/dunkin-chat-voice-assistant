# Dockerfile.edge — Azure Local / edge deployment image
#
# Extends the cloud image with edge-only dependencies (chromadb, onnxruntime)
# and sets USE_LOCAL_PIPELINE=true by default.
#
# Build:
#   docker build -f app/Dockerfile.edge -t dunkin-voice-edge app/
#
# The chroma_data/ directory must be mounted or baked in at build time
# after running scripts/ingest_menu_local.py.

# Stage 1: Build the Vite app
FROM node:22-slim AS build-stage

WORKDIR /frontend

COPY frontend ./

RUN if [ ! -f .env ]; then \
      printf "VITE_AUTH_URL=\nVITE_AUTH_ENABLED=false\n" > .env; \
    fi

RUN npm ci
RUN npm run build

# Stage 2: Python backend with edge dependencies
FROM python:3.12-slim AS production-stage

WORKDIR /app
COPY ./backend/ /app

# Provide menu metadata to the backend at runtime.
RUN mkdir -p /app/data
COPY ./frontend/src/data/menuItems.json /app/data/menuItems.json

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install cloud + edge dependencies
RUN python -m pip install --no-cache-dir \
    -r requirements.txt \
    -r requirements-edge.txt

# Copy the freshly-built frontend assets.
COPY --from=build-stage /backend/static /app/static

# Enable local pipeline by default for edge deployments.
ENV USE_LOCAL_PIPELINE=true

CMD ["python3", "-m", "gunicorn", "app:create_app", "-b", "0.0.0.0:8000", "--workers", "1", "--worker-class", "aiohttp.GunicornWebWorker", "--timeout", "120", "--keep-alive", "65", "--graceful-timeout", "30"]
