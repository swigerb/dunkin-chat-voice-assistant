# Edge deploy settings for scripts/deploy-edge.sh and scripts/deploy-edge.ps1.
# Copy to .env (git-ignored) and fill in YOUR OWN values:
#   cp .env.template .env            (bash)
#   Copy-Item .env.template .env     (PowerShell)
# Both scripts read KEY=value lines: no quotes, no spaces around "=", no spaces in values.
# See docs/azure-local-deployment.md for what each value is for.

# --- Required ---------------------------------------------------------------
# Azure subscription (GUID) that holds the ACR and Key Vault below.
AZURE_SUBSCRIPTION_ID=
# Resource group for the ACR and Key Vault (created if missing).
AZURE_RESOURCE_GROUP=
# Azure region, e.g. eastus2.
AZURE_LOCATION=
# Key Vault name (globally unique). The Azure OpenAI endpoint and key are stored here.
AZURE_KEYVAULT_NAME=
# Azure Container Registry name, without .azurecr.io (globally unique).
AZURE_ACR_NAME=
# Endpoint of YOUR Azure OpenAI account with a gpt-realtime-2.1 (version 2026-07-07)
# deployment, e.g. https://your-aoai-account.openai.azure.com/
AZURE_OPENAI_EASTUS2_ENDPOINT=
# API key of that Azure OpenAI account. Never commit it.
AZURE_OPENAI_EASTUS2_API_KEY=

# --- Optional (defaults shown in comments) ----------------------------------
# Defaults to AZURE_RESOURCE_GROUP.
AZURE_KEYVAULT_RG=
# standard
AZURE_KEYVAULT_SKU=
# Defaults to AZURE_RESOURCE_GROUP.
AZURE_ACR_RG=
# Standard
AZURE_ACR_SKU=
# dunkin-voice-assistant
DOCKER_IMAGE_NAME=
# latest
DOCKER_IMAGE_TAG=
# dunkin-voice
K8S_NAMESPACE=
# Client ID of the AKS managed identity the Key Vault CSI driver uses.
AKS_MANAGED_IDENTITY_CLIENT_ID=
# Entra ID tenant (GUID) of the Key Vault.
AZURE_TENANT_ID=
